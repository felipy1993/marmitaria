
// Regras de Segurança do Firestore para Marmitaria (Modelo White Label)
// Copie e cole estas regras no Firebase Console > Firestore Database > Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar se o usuário é Administrador
    // No seu modelo, Admins entram via Email/Senha (password)
    function isAdmin() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Configurações do Restaurante
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Produtos - Leitura pública para a loja, escrita restrita ao Admin
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Cupons - Leitura pública para conferência, escrita restrita ao Admin
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
      // O cliente pode apenas disparar a atualização do contador de uso ao finalizar pedido
      allow update: if request.resource.data.usedCount == resource.data.usedCount + 1;
    }
    
    // Pedidos (Orders)
    match /orders/{orderId} {
      // Qualquer um pode criar um pedido
      allow create: if true;
      
      // Leitura permitida para todos para facilitar o acompanhamento via ID ou GuestId
      // A segurança real é o ID ser um hash aleatório difícil de adivinhar
      allow read: if true;
      
      // Apenas Admin pode deletar pedidos.
      // O cliente pode ATUALIZAR para vincular o pedido à sua conta (migração de guest para user)
      allow delete: if isAdmin();
      allow update: if isAdmin() || (resource.data.guestId != null && request.resource.data.guestId == resource.data.guestId);
    }
    
    // Transações Financeiras - TOTALMENTE RESTRITO AO ADMIN
    // Clientes nem conseguem ler que isso existe
    match /transactions/{transactionId} {
      allow read, write: if isAdmin();
    }

    // Coleções legadas ou futuras de segurança
    match /sales/{saleId} { allow read, write: if isAdmin(); }
    match /expenses/{expenseId} { allow read, write: if isAdmin(); }
    match /stock/{stockId} { allow read, write: if isAdmin(); }
  }
}
