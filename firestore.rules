// Regras de Segurança do Firestore para Marmitaria
// Copie e cole estas regras no Firebase Console > Firestore Database > Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Configurações do Restaurante (Legacy)
    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Configurações do Restaurante (Current)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Produtos - Leitura pública (IMPRESCINDÍVEL para a loja funcionar), escrita apenas logado
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Cupons - Leitura pública para conferência, escrita restrita ao admin
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null;
      // Permite incrementar o uso do cupom apenas se o valor for exatamente 1
      allow update: if request.resource.data.usedCount == resource.data.usedCount + 1;
    }
    
    // Pedidos - Usuários podem criar e ler seus próprios pedidos
    match /orders/{orderId} {
      // Permite criar pedido (qualquer um pode pedir)
      allow create: if true;
      
      // Permite ler:
      // 1. Admin (autenticado por senha)
      // 2. O próprio usuário logado (matching userId)
      // 3. O próprio guest (matching guestId no pedido)
      allow read: if request.auth != null || 
                 (resource.data.guestId != null && request.query.guestId == resource.data.guestId) ||
                 (resource.data.userId != null && request.auth.uid == resource.data.userId);
      
      // Apenas admin pode atualizar pedidos
      allow update: if request.auth != null;
      
      // Apenas admin pode deletar
      allow delete: if request.auth != null;
    }
    
    // Vendas - Apenas admin
    match /sales/{saleId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Despesas - Apenas admin
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Estoque - Apenas admin
    match /stock/{stockId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
